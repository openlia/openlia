#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

biome_files=()
go_files=()
md_files=()

while IFS= read -r file; do
  [[ -z "$file" || ! -f "$file" ]] && continue
  case "$file" in
    *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.json|*.css)
      biome_files+=("$file")
      ;;
    *.go)
      go_files+=("$file")
      ;;
    *.md)
      md_files+=("$file")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ ${#biome_files[@]} -gt 0 ]]; then
  echo "[pre-commit] Formatting ${#biome_files[@]} staged file(s) with Biome..."
  bunx biome format --write --no-errors-on-unmatched "${biome_files[@]}"
  git add -- "${biome_files[@]}"
  bun run format:check
fi

if [[ ${#go_files[@]} -gt 0 ]]; then
  echo "[pre-commit] Formatting ${#go_files[@]} staged Go file(s) with gofmt..."
  gofmt -s -w "${go_files[@]}"
  git add -- "${go_files[@]}"
fi

if [[ ${#md_files[@]} -gt 0 ]]; then
  echo "[pre-commit] Linting and formatting ${#md_files[@]} staged Markdown file(s)..."
  bunx markdownlint-cli2 --fix "${md_files[@]}"
  bunx prettier --write "${md_files[@]}"
  git add -- "${md_files[@]}"
  bunx prettier --check "${md_files[@]}"
  bunx markdownlint-cli2 "${md_files[@]}"
fi
