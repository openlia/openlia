{
  "name": "@openlia/workspace-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --host 127.0.0.1 --port 6006 --no-open",
    "build:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --output-dir .storybook-static",
    "dev": "vite",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:server": "bun test src/server",
    "sync:schema": "bun scripts/sync-openui-schema.ts --write",
    "check:schema": "bun scripts/sync-openui-schema.ts",
    "typecheck": "bun run check:schema && bun run typecheck:server && bun run typecheck:client && bun run typecheck:storybook",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json --noEmit",
    "build": "bun run build:client && bun run bundle:server",
    "build:client": "vite build",
    "bundle:server": "bun build src/server/main.ts --target=bun --format=esm --outfile=dist/server.js && bun run bundle:openui",
    "bundle:openui": "bun build scripts/openui-authoring.ts --target=bun --format=esm --minify --outfile=dist/openui-authoring.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.43.15",
    "@openuidev/lang-core": "^1.0.1",
    "@openuidev/react-lang": "^1.0.1",
    "@openuidev/react-ui": "^0.18.1",
    "d3-sankey": "^0.12.3",
    "mdast-util-from-markdown": "^2.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.8.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/vite": "4",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/bun": "^1.2.22",
    "@types/d3-sankey": "^0.12.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "daisyui": "5",
    "happy-dom": "18.0.1",
    "mockdate": "3.0.5",
    "storybook": "10.6.4",
    "tailwindcss": "4",
    "typescript": "^5.8.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
