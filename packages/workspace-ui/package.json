{
  "name": "@openlia/workspace-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:server": "bun test src/server",
    "typecheck": "bun run typecheck:server && bun run typecheck:client",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build": "bun run build:client && bun run bundle:server",
    "build:client": "vite build",
    "bundle:server": "bun build src/server/main.ts --target=bun --format=esm --outfile=dist/server.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.43.15",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/bun": "^1.2.22",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "daisyui": "5",
    "happy-dom": "18.0.1",
    "tailwindcss": "4",
    "typescript": "^5.8.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
