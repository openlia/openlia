root = Stack([header, metrics, board, table])
header = DomainHeader("Tasks", "Track concrete actions across todo, in-progress, waiting, and done.")
metrics = Grid([
  MetricCard("To Do", @Query("todo_count"), "Ready to start"),
  MetricCard("In Progress", @Query("in_progress_count"), "Active work"),
  MetricCard("High Priority", @Query("high_priority_count"), "Urgent focus"),
  MetricCard("Completed", @Query("done_count"), "Finished actions")
], 4)
board = RecordKanban("status", ["todo", "in-progress", "waiting", "done"])
table = RecordTable(["title", "status", "priority", "due_date"])
