{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "domains"],
  "properties": {
    "$schema": {
      "const": "./workspace.schema.json"
    },
    "version": {
      "const": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/domain"
      },
      "minItems": 7
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "label", "purpose"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "kind": {
          "enum": ["core", "extension"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "route": {
          "enum": ["task", "event", "decision", "idea", "research", "claim", "finance", "archive", "review", null]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "template": {
          "type": ["string", "null"]
        },
        "include_in_briefing": {
          "type": "boolean",
          "default": false
        },
        "briefing_category": {
          "enum": ["calendar", "tasks", "projects", "goals", "decisions", "monitors", "claims", "finance", "inbox", "extension", null]
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "feature": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "extension"
              }
            }
          },
          "then": {
            "required": ["lifecycle"],
            "properties": {
              "lifecycle": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "required": ["include_in_briefing"],
            "properties": {
              "include_in_briefing": {
                "const": true
              }
            }
          },
          "then": {
            "required": ["briefing_category"],
            "properties": {
              "briefing_category": {
                "type": "string",
                "enum": ["calendar", "tasks", "projects", "goals", "decisions", "monitors", "claims", "finance", "inbox", "extension"]
              }
            }
          }
        }
      ]
    }
  }
}
