{
  "name": "openlia",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:openlia-browser",
    "build:openlia-browser": "bun build packages/openlia-browser/src/server.ts --target=bun --outfile packages/openlia-browser/dist/server.js",
    "lint": "bunx @biomejs/biome check packages/openlia-browser",
    "format": "bunx @biomejs/biome format --write packages/openlia-browser package.json biome.json",
    "format:check": "bunx @biomejs/biome format packages/openlia-browser package.json biome.json",
    "typecheck": "bun run typecheck:openlia-browser",
    "typecheck:openlia-browser": "bunx tsc --noEmit -p packages/openlia-browser/tsconfig.json",
    "test": "bun run test:openlia-browser",
    "test:openlia-browser": "bun test packages/openlia-browser/src",
    "verify-dist": "bun run build && test -s packages/openlia-browser/dist/server.js",
    "check": "bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "0.0.70"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/bun": "^1.2.22",
    "typescript": "^5.8.2"
  }
}
