# OpenLia Remind Calendar Template
# Reference: https://manpages.debian.org/testing/remind/remind.1.en.html
#
# Syntax:
#   REM <date_spec> [THROUGH <end_date>] [AT <time>] [DURATION <duration>] [TAG <tag>]... [INFO "<Header>: <Value>"]... MSG <Summary>
#
# Square brackets above denote optional syntax; do not copy them into literal
# prose. Remind parses bracketed text as an expression. Use parentheses for
# ordinary text and preserve UTF-8 event names.
#
# Supported INFO Headers:
#   INFO "Attendees: Name <email>, openlia://workspace/people/person.md"
#   INFO "Location: Address, Room, or Venue"
#   INFO "Map-Url: https://maps.google.com/?q=..."
#   INFO "Video-Link: https://meet.google.com/... or https://zoom.us/..."
#   INFO "Description: Agenda, background, or meeting context"
#   INFO "Event-Note: calendar/YYYY-MM-DD-event-title.md"

# Example 1: In-person meeting with physical location and Google Maps link
# REM 2026-10-15 AT 10:00 DURATION 1:00 \
#     TAG meeting TAG client \
#     INFO "Location: 123 Market St, San Francisco, CA" \
#     INFO "Map-Url: https://maps.google.com/?q=123+Market+St+San+Francisco+CA" \
#     INFO "Attendees: Alice Smith <alice@example.com>, openlia://workspace/people/bob-jones.md" \
#     INFO "Description: Quarterly client sync and roadmap review" \
#     INFO "Event-Note: calendar/2026-10-15-client-review.md" \
#     MSG Client Roadmap Review

# Example 2: Remote video conference with Google Meet / Zoom link
# REM 2026-10-16 AT 14:30 DURATION 0:45 \
#     TAG 1on1 \
#     INFO "Video-Link: https://meet.google.com/abc-defg-hij" \
#     INFO "Attendees: Carol Danvers <carol@example.com>" \
#     INFO "Description: Bi-weekly 1:1 sync" \
#     MSG 1:1 with Carol

# Example 3: Recurring weekly team standup
# REM Mon Tue Wed Thu Fri AT 09:30 DURATION 0:15 \
#     TAG standup \
#     INFO "Video-Link: https://zoom.us/j/1234567890" \
#     INFO "Attendees: openlia://workspace/people/engineering-team.md" \
#     MSG Daily Standup

# Example 4: Multi-day holiday or date range (inclusive dates)
# REM 15 Oct 2026 THROUGH 19 Oct 2026 \
#     TAG holiday TAG school TAG lina \
#     INFO "Description: Lina — Nghỉ giữa học kỳ I" \
#     MSG Lina — Nghỉ giữa học kỳ I

