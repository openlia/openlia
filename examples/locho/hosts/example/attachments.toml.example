# Copy this file to the VM as:
# <install-root>/runtime/locho/<host>/attachments.toml
# Replace every placeholder out of band. Capability values must never enter Git.
host_id = "<locho-host-id>"
listen_host = "0.0.0.0"

[[services]]
capability = "<service-name>:http:<capability>"
listen_port = 18765
# Optional HTTP response timeout in seconds (1-300; default 60).
# http_timeout_secs = 90

# Inside the private Compose network, Hermes and other containers reach these
# services using http://locho-<host>:<listen_port>.
# For example, if host is "<host>" and listen_port is 8088:
# Configure this explicit endpoint in config.toml:
#   base_url = "http://locho-<host>:8088/v1"
# And for openlia-browser on port 8932:
#   OPENLIA_BROWSER_MCP_URL="http://locho-<host>:8932"

# Host-local openlia-browser service (Playwright supervisor + MCP proxy):
# [[services]]
# capability = "openlia-browser:http:<capability>"
# listen_port = 8932
