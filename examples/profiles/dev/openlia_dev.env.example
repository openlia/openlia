# Secret environment template for running development drills.
# Copy to ~/.config/openlia/dev/openlia_dev.env and chmod 600.
#
# IMPORTANT: Values must strictly conform to OpenLia secret format rules:
# - COPILOT_GITHUB_TOKEN must start with gho_, ghu_, or github_pat_.
# - If an invalid or unexpected token format is included, Hermes' secret-source
#   helper will fail validation and drop all secrets.

# 32+ character random string for internal API authentication:
API_SERVER_KEY=example_api_server_key_32_characters_or_more

# Primary LLM provider token:
COPILOT_GITHUB_TOKEN=gho_exampleCopilotTokenHere

# Optional Gateway API key (if using fallback providers):
OPENAI_GATEWAY_API_KEY=example_gateway_key_here

# Hermes Dashboard Auth Option A: Basic Auth (set via `openlia auth --config config.toml`):
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change_me_strong_password

# Hermes Dashboard Auth Option B: OIDC / GCP OAuth / Auth0 (set via `openlia auth --oidc --config config.toml`):
# HERMES_DASHBOARD_OIDC_ISSUER=https://accounts.google.com
# HERMES_DASHBOARD_OIDC_CLIENT_ID=xxxx.apps.googleusercontent.com
# HERMES_DASHBOARD_OIDC_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
# HERMES_DASHBOARD_PUBLIC_URL=http://127.0.0.1:9119

# Telegram Bot integration:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz
TELEGRAM_ALLOWED_USERS=123456789
