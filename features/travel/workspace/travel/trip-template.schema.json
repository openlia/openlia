{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:trip",
  "title": "Trip template frontmatter schema",
  "type": "object",
  "properties": {
    "start_date": {"type": ["string", "null"], "format": "date"},
    "end_date": {"type": ["string", "null"], "format": "date"},
    "destination": {"type": ["string", "null"], "minLength": 1},
    "purpose": {
      "type": ["string", "null"],
      "enum": [null, "vacation", "work / conference", "family", "relocation"]
    },
    "status": {
      "type": ["string", "null"],
      "enum": [null, "planning", "booked", "in-progress", "completed"]
    }
  },
  "required": ["start_date", "end_date", "destination", "purpose", "status"],
  "additionalProperties": false
}
