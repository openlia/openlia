{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:shopping-item",
  "title": "Shopping item template frontmatter schema",
  "type": "object",
  "properties": {
    "category": {
      "type": ["string", "null"],
      "enum": [null, "electronics", "household", "clothing", "tools", "books", "other"]
    },
    "classification": {
      "type": ["string", "null"],
      "enum": [null, "essential need", "quality-of-life upgrade", "discretionary want"]
    },
    "priority": {
      "type": ["string", "null"],
      "enum": [null, "urgent", "medium", "low"]
    },
    "status": {
      "type": ["string", "null"],
      "enum": [null, "researching", "watching-price", "ready-to-buy", "purchased", "abandoned"]
    }
  },
  "required": ["category", "classification", "priority", "status"],
  "additionalProperties": false
}
