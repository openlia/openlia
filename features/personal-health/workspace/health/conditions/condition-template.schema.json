{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:health-condition",
  "title": "Health condition frontmatter schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "person_id", "kind", "name", "family_member_relation", "related_person_id", "verification_status", "clinical_status", "onset", "abatement", "coding", "source_refs", "history_ids", "review_after"],
  "properties": {
    "id": {"type": ["string", "null"], "minLength": 1},
    "person_id": {"type": ["string", "null"], "minLength": 1},
    "kind": {"enum": ["diagnosis", "allergy", "intolerance", "risk-factor", "family-history", "other"]},
    "name": {"type": ["string", "null"], "minLength": 1},
    "family_member_relation": {"type": ["string", "null"], "minLength": 1},
    "related_person_id": {"type": ["string", "null"], "minLength": 1},
    "verification_status": {"enum": ["unconfirmed", "reported", "provisional", "confirmed", "refuted", "entered-in-error", "unknown"]},
    "clinical_status": {"enum": ["active", "recurrence", "relapse", "inactive", "remission", "resolved", "unknown"]},
    "onset": {"$ref": "#/$defs/dateOrDateTime"},
    "abatement": {"$ref": "#/$defs/dateOrDateTime"},
    "coding": {"$ref": "#/$defs/coding"},
    "source_refs": {"$ref": "#/$defs/idList"},
    "history_ids": {"$ref": "#/$defs/idList"},
    "review_after": {"type": ["string", "null"], "format": "date"}
  },
  "$defs": {
    "dateOrDateTime": {
      "type": ["string", "null"],
      "pattern": "^(?:[0-9]{4}|[0-9]{4}-(?:0[1-9]|1[0-2])|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?(?:Z|[+-](?:0[0-9]|1[0-4]):[0-5][0-9]))$"
    },
    "coding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["system", "code", "display"],
      "properties": {
        "system": {"type": ["string", "null"], "minLength": 1},
        "code": {"type": ["string", "null"], "minLength": 1},
        "display": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "idList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
