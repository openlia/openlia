{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:health-history",
  "title": "Health history entry frontmatter schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "person_id",
    "kind",
    "status",
    "occurred_start",
    "occurred_end",
    "recorded_at",
    "source_type",
    "source_ref",
    "coding",
    "condition_ids",
    "treatment_ids",
    "calendar_refs",
    "results"
  ],
  "properties": {
    "id": {"type": ["string", "null"], "minLength": 1},
    "person_id": {"type": ["string", "null"], "minLength": 1},
    "kind": {"enum": ["symptom", "encounter", "test", "procedure", "immunization", "hospitalization", "allergy-reaction", "other"]},
    "status": {"enum": ["draft", "reported", "confirmed", "amended", "entered-in-error", "archived"]},
    "occurred_start": {"$ref": "#/$defs/dateOrDateTime"},
    "occurred_end": {"$ref": "#/$defs/dateOrDateTime"},
    "recorded_at": {"$ref": "#/$defs/timestamp"},
    "source_type": {"enum": ["user-report", "clinician", "lab-report", "imaging-report", "device", "imported-record", "other"]},
    "source_ref": {"type": ["string", "null"], "minLength": 1},
    "coding": {"$ref": "#/$defs/coding"},
    "condition_ids": {"$ref": "#/$defs/idList"},
    "treatment_ids": {"$ref": "#/$defs/idList"},
    "calendar_refs": {"$ref": "#/$defs/idList"},
    "results": {
      "type": "array",
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "dateOrDateTime": {
      "type": ["string", "null"],
      "pattern": "^(?:[0-9]{4}|[0-9]{4}-(?:0[1-9]|1[0-2])|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?(?:Z|[+-](?:0[0-9]|1[0-4]):[0-5][0-9]))$"
    },
    "timestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "coding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["system", "code", "display"],
      "properties": {
        "system": {"type": ["string", "null"], "minLength": 1},
        "code": {"type": ["string", "null"], "minLength": 1},
        "display": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "idList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit", "reference_range", "interpretation", "coding"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string", "null"]},
        "unit": {"type": ["string", "null"], "minLength": 1},
        "reference_range": {"type": ["string", "null"], "minLength": 1},
        "interpretation": {"type": ["string", "null"], "minLength": 1},
        "coding": {"$ref": "#/$defs/coding"}
      }
    }
  }
}
