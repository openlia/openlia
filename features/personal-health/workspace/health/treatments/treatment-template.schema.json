{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:health-treatment",
  "title": "Health treatment frontmatter schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "person_id", "kind", "name", "status", "intent", "started_on", "ended_on", "source_type", "source_ref", "condition_ids", "history_ids", "calendar_refs", "revision_of", "medication"],
  "properties": {
    "id": {"type": ["string", "null"], "minLength": 1},
    "person_id": {"type": ["string", "null"], "minLength": 1},
    "kind": {"enum": ["medication", "therapy", "procedure", "lifestyle", "other"]},
    "name": {"type": ["string", "null"], "minLength": 1},
    "status": {"enum": ["planned", "active", "completed", "stopped", "on-hold", "not-taken", "unknown", "entered-in-error"]},
    "intent": {"enum": ["prescribed", "recommended", "reported-use", "self-directed", "completed", "unknown"]},
    "started_on": {"$ref": "#/$defs/dateOrDateTime"},
    "ended_on": {"$ref": "#/$defs/dateOrDateTime"},
    "source_type": {"enum": ["user-report", "clinician", "prescription", "discharge-summary", "imported-record", "other"]},
    "source_ref": {"type": ["string", "null"], "minLength": 1},
    "condition_ids": {"$ref": "#/$defs/idList"},
    "history_ids": {"$ref": "#/$defs/idList"},
    "calendar_refs": {"$ref": "#/$defs/idList"},
    "revision_of": {"type": ["string", "null"], "minLength": 1},
    "medication": {"$ref": "#/$defs/medication"}
  },
  "$defs": {
    "dateOrDateTime": {
      "type": ["string", "null"],
      "pattern": "^(?:[0-9]{4}|[0-9]{4}-(?:0[1-9]|1[0-2])|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?(?:Z|[+-](?:0[0-9]|1[0-4]):[0-5][0-9]))$"
    },
    "coding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["system", "code", "display"],
      "properties": {
        "system": {"type": ["string", "null"], "minLength": 1},
        "code": {"type": ["string", "null"], "minLength": 1},
        "display": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "idList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "medication": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["strength", "dose", "dose_unit", "route", "frequency", "prescriber", "coding"],
      "properties": {
        "strength": {"type": ["string", "null"], "minLength": 1},
        "dose": {"type": ["number", "string", "null"]},
        "dose_unit": {"type": ["string", "null"], "minLength": 1},
        "route": {"type": ["string", "null"], "minLength": 1},
        "frequency": {"type": ["string", "null"], "minLength": 1},
        "prescriber": {"type": ["string", "null"], "minLength": 1},
        "coding": {"$ref": "#/$defs/coding"}
      }
    }
  }
}
