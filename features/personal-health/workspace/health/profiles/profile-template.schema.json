{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:health-profile",
  "title": "Health profile frontmatter schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "person_id",
    "display_name",
    "relationship_to_user",
    "people_ref",
    "date_of_birth",
    "identity_status",
    "source_refs"
  ],
  "properties": {
    "id": {"type": ["string", "null"], "minLength": 1},
    "person_id": {"type": ["string", "null"], "minLength": 1},
    "display_name": {"type": ["string", "null"], "minLength": 1},
    "relationship_to_user": {
      "enum": [null, "self", "child", "spouse", "partner", "parent", "sibling", "grandparent", "grandchild", "other-family", "caregiver", "other"]
    },
    "people_ref": {"type": ["string", "null"], "minLength": 1},
    "date_of_birth": {
      "type": ["string", "null"],
      "pattern": "^(?:[0-9]{4}|[0-9]{4}-(?:0[1-9]|1[0-2])|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01]))$"
    },
    "identity_status": {"enum": ["active", "inactive", "deceased", "unknown"]},
    "source_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
