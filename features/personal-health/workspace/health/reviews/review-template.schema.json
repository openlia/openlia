{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:health-review",
  "title": "Health review frontmatter schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "person_id", "review_type", "status", "as_of", "generated_at", "source_record_ids", "information_gaps", "next_review_on"],
  "properties": {
    "id": {"type": ["string", "null"], "minLength": 1},
    "person_id": {"type": ["string", "null"], "minLength": 1},
    "review_type": {"enum": ["medical-summary", "condition-summary", "treatment-summary", "clinician-handoff", "other"]},
    "status": {"enum": ["draft", "final", "archived"]},
    "as_of": {"$ref": "#/$defs/dateOrDateTime"},
    "generated_at": {"type": ["string", "null"], "format": "date-time"},
    "source_record_ids": {"$ref": "#/$defs/idList"},
    "information_gaps": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "next_review_on": {"type": ["string", "null"], "format": "date"}
  },
  "$defs": {
    "dateOrDateTime": {
      "type": ["string", "null"],
      "pattern": "^(?:[0-9]{4}|[0-9]{4}-(?:0[1-9]|1[0-2])|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?(?:Z|[+-](?:0[0-9]|1[0-4]):[0-5][0-9]))$"
    },
    "idList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
