{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:person",
  "title": "Person template frontmatter schema",
  "type": "object",
  "properties": {
    "relationship": {
      "type": ["string", "null"],
      "enum": [null, "colleague", "mentor", "collaborator", "friend", "family", "advisor"]
    },
    "organization": {"type": ["string", "null"], "minLength": 1},
    "role": {"type": ["string", "null"], "minLength": 1},
    "location": {"type": ["string", "null"], "minLength": 1},
    "timezone": {"type": ["string", "null"], "minLength": 1},
    "important_dates": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "required": ["relationship", "organization", "role", "location", "timezone", "important_dates"],
  "additionalProperties": false
}
