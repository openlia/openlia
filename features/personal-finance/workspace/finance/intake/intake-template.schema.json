{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:finance-intake",
  "title": "Finance intake record frontmatter schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "source_type",
    "source_ref",
    "received_date",
    "period_start",
    "period_end",
    "account_scope",
    "review_date",
    "authority",
    "reconciliation_status"
  ],
  "properties": {
    "id": {"type": ["string", "null"], "minLength": 1},
    "status": {
      "enum": ["received", "extracting", "pending-review", "ready-to-post", "posted", "reconciled", "blocked", "archived"]
    },
    "source_type": {
      "enum": ["bank-statement", "card-statement", "wallet-statement", "cash-note", "payslip", "receipt", "manual-entry", "other"]
    },
    "source_ref": {"type": ["string", "null"], "minLength": 1},
    "received_date": {"type": ["string", "null"], "format": "date"},
    "period_start": {"type": ["string", "null"], "format": "date"},
    "period_end": {"type": ["string", "null"], "format": "date"},
    "account_scope": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "review_date": {"type": ["string", "null"], "format": "date"},
    "authority": {"enum": ["pending", "direct-request", "standing-delegation"]},
    "reconciliation_status": {
      "enum": ["not-started", "pending", "matched", "discrepancy", "not-applicable"]
    }
  }
}
