{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:finance-reviews",
  "title": "Finance review record frontmatter schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "period",
    "review_date",
    "status",
    "reporting_currency",
    "data_start",
    "data_end",
    "reconciliation_status",
    "next_review_date"
  ],
  "properties": {
    "period": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2]|Q[1-4])$"
    },
    "review_date": {"type": ["string", "null"], "format": "date"},
    "status": {"enum": ["draft", "needs-attention", "final", "archived"]},
    "reporting_currency": {"type": ["string", "null"], "minLength": 1},
    "data_start": {"type": ["string", "null"], "format": "date"},
    "data_end": {"type": ["string", "null"], "format": "date"},
    "reconciliation_status": {
      "enum": ["not-started", "in-progress", "complete", "discrepancy"]
    },
    "next_review_date": {"type": ["string", "null"], "format": "date"}
  }
}
