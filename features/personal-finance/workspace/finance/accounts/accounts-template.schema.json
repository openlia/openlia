{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:finance-accounts",
  "title": "Finance account record frontmatter schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "account_type",
    "ledger_account",
    "institution_label",
    "currencies",
    "opening_balance_date",
    "reconciliation_frequency",
    "last_reconciled"
  ],
  "properties": {
    "id": {"type": ["string", "null"], "minLength": 1},
    "status": {"enum": ["active", "closed", "archived"]},
    "account_type": {
      "enum": ["bank", "credit-card", "cash", "e-wallet", "brokerage", "exchange", "loan", "other"]
    },
    "ledger_account": {"type": ["string", "null"], "minLength": 1},
    "institution_label": {"type": ["string", "null"], "minLength": 1},
    "currencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "opening_balance_date": {"type": ["string", "null"], "format": "date"},
    "reconciliation_frequency": {"enum": ["weekly", "monthly", "quarterly", "none", null]},
    "last_reconciled": {"type": ["string", "null"], "format": "date"}
  }
}
