{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:finance-portfolios",
  "title": "Finance portfolio record frontmatter schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "portfolio_type",
    "valuation_date",
    "base_currency",
    "included_accounts",
    "price_status",
    "cost_basis_status",
    "target_review_date"
  ],
  "properties": {
    "id": {"type": ["string", "null"], "minLength": 1},
    "status": {"enum": ["active", "closed", "archived"]},
    "portfolio_type": {"enum": ["securities", "crypto", "mixed", "retirement", "other"]},
    "valuation_date": {"type": ["string", "null"], "format": "date"},
    "base_currency": {"type": ["string", "null"], "minLength": 1},
    "included_accounts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "price_status": {"enum": ["complete", "partial", "missing", "not-applicable"]},
    "cost_basis_status": {"enum": ["complete", "partial", "missing", "not-applicable"]},
    "target_review_date": {"type": ["string", "null"], "format": "date"}
  }
}
