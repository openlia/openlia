{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:finance",
  "title": "Finance template frontmatter schema",
  "type": "object",
  "properties": {
    "period": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2]|Q[1-4])$"
    },
    "review_date": {"type": ["string", "null"], "format": "date"}
  },
  "required": ["period", "review_date"],
  "additionalProperties": false
}
