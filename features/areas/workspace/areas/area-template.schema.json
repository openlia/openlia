{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:area",
  "title": "Area template frontmatter schema",
  "type": "object",
  "properties": {
    "review_frequency": {
      "type": ["string", "null"],
      "enum": [null, "daily", "weekly", "monthly", "quarterly"]
    },
    "last_reviewed": {
      "type": ["string", "null"],
      "format": "date"
    }
  },
  "required": ["review_frequency", "last_reviewed"],
  "additionalProperties": false
}
