{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:decision",
  "title": "Decision template frontmatter schema",
  "type": "object",
  "properties": {
    "status": {
      "type": ["string", "null"],
      "enum": [null, "proposed", "decided", "superseded", "abandoned"]
    },
    "decision_date": {"type": ["string", "null"], "format": "date"},
    "review_date": {"type": ["string", "null"], "format": "date"}
  },
  "required": ["status", "decision_date", "review_date"],
  "additionalProperties": false
}
