{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:monitor",
  "title": "Monitor template frontmatter schema",
  "type": "object",
  "properties": {
    "status": {
      "type": ["string", "null"],
      "enum": [null, "active", "paused", "triggered", "retired"]
    },
    "source": {"type": ["string", "null"], "minLength": 1},
    "check_frequency": {
      "type": ["string", "null"],
      "enum": [null, "hourly", "daily", "weekly", "monthly"]
    },
    "alert_channel": {"type": ["string", "null"], "minLength": 1}
  },
  "required": ["status", "source", "check_frequency", "alert_channel"],
  "additionalProperties": false
}
